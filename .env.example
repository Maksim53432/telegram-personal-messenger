# Ключи приложения Telegram: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Необязательно: строковая сессия Telethon. Это секрет, не коммить файл .env.
# TG_SESSION=

# Необязательно: локальный прокси, если Telegram напрямую не открывается.
# socks/http: TG_PROXY=socks5://127.0.0.1:1080
# MTProto (ссылка из Telegram): TG_PROXY=https://t.me/proxy?server=127.0.0.1&port=1443&secret=dd...
